{
    "name": "mf/staffcore",
    "description": "Modular HR management platform",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "3.1.6",
        "monolog/monolog": "^3.0",
        "php-di/php-di": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "MF\\StaffCore\\": "core/",
            "MF\\StaffCore\\Modules\\": "modules/",
            "MF\\StaffCore\\Platforms\\WordPress\\": "platforms/wordpress/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MF\\StaffCore\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "dg/bypass-finals": "^1.9",
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
